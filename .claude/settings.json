{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git worktree:*)",
      "Bash(git rebase:*)",
      "Bash(git revert:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git push:*)",
      "Bash(git -C ops:*)",
      "Bash(npm ci:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(cp -R \"/Users/aryamahadik/Downloads/Rosfield_Main/Rosfield Main Handover/1 Business Rules (Master Flow, do not edit)/1 Read First/.\" scratch/master-copy/)",
      "Bash(cp -R \"/Users/aryamahadik/Downloads/Rosfield_Main/Rosfield Main Handover/1 Business Rules (Master Flow, do not edit)/2 Read When Building/.\" scratch/master-copy/)",
      "Bash(cp -R \"/Users/aryamahadik/Downloads/Rosfield_Main/Rosfield Main Handover/1 Business Rules (Master Flow, do not edit)/3 Build Data and Tools/.\" scratch/master-copy/)",
      "Bash(chmod -R u+w scratch/master-copy)",
      "Bash(node scratch/master-copy/engine/work/build/step.js:*)",
      "Bash(docker compose -f infra/docker-compose.yml:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run watch:*)",
      "Bash(gh workflow run merge-check.yml:*)",
      "Bash(date:*)",
      "Bash(sleep:*)",
      "Bash(rm -f ops/LEAD.lock)",
      "Bash(rm ops/LEAD.lock)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(pwd)",
      "Bash(echo:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env.*)",
      "Read(**/.dev.vars)",
      "Edit(**/.dev.vars)",
      "Read(**/.dev.vars.*)",
      "Edit(**/.dev.vars.*)",
      "Read(~/.config/rosfield/**)",
      "Edit(~/.config/rosfield/**)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Edit(//Users/aryamahadik/Downloads/Rosfield_Main/Rosfield Main Handover/**)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push origin +main:*)",
      "Bash(git push origin master:*)",
      "Bash(git push origin HEAD:master:*)",
      "Bash(git push origin +master:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push -u origin master:*)",
      "Bash(git push --all:*)",
      "Bash(git push --mirror:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(npx wrangler deploy:*)",
      "Bash(wrangler deploy:*)",
      "Bash(npm run deploy:production:*)",
      "Agent(fork)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\""
          }
        ]
      }
    ]
  }
}
