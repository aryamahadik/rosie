{
  "name": "rosie",
  "version": "0.0.0",
  "private": true,
  "description": "Rosie by Rosfield: the AI booking assistant",
  "type": "module",
  "engines": {
    "node": "^22.12.0",
    "npm": ">=10"
  },
  "workspaces": [
    "contracts",
    "compiler",
    "db",
    "runtime",
    "actions",
    "ai",
    "adapters",
    "web",
    "evals",
    "tests"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p db/tsconfig.erasable.json",
    "pretest": "npm run build:validators",
    "test": "vitest run --project unit --project workers --project contract",
    "pretest:unit": "npm run build:validators",
    "test:unit": "vitest run --project unit",
    "pretest:workers": "npm run build:validators",
    "test:workers": "vitest run --project workers",
    "pretest:contract": "npm run build:validators",
    "test:contract": "vitest run --project contract",
    "test:parity": "vitest run --project parity",
    "pretest:integration": "npm run build:validators",
    "test:integration": "vitest run --project integration",
    "pretest:scenario": "npm run build:validators",
    "test:scenario": "vitest run --project scenario",
    "pretest:e2e": "npm run build:validators",
    "test:e2e": "vitest run --project e2e --project e2e-workers",
    "test:scripts": "node --test \"infra/scripts/*.test.mjs\"",
    "pretest:ci-scripts": "npm run build:validators",
    "test:ci-scripts": "node --test \"infra/ci/*.test.mjs\"",
    "pretest:count": "npm run build:validators",
    "test:count": "node infra/scripts/test-count.mjs",
    "guard:tests": "node infra/ci/test-guard.mjs",
    "guard:migrations": "node infra/ci/migration-guard.mjs",
    "guard:contracts": "node infra/ci/contract-freeze-guard.mjs",
    "merge-check:local": "node infra/ci/local-merge-check.mjs",
    "contracts:types": "npm run types --workspace contracts --if-present && npm run build:validators",
    "build:validators": "node infra/build/tool-api-validators.mjs",
    "contracts:check": "npm run check --workspace contracts --if-present",
    "db:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:psql": "docker compose -f infra/docker-compose.yml exec rosie-pg psql -U rosie rosie",
    "migrate": "node infra/scripts/migrate.mjs",
    "cf": "bash infra/scripts/cf.sh",
    "deploy:preview": "bash infra/scripts/deploy-preview.sh",
    "preview:cleanup": "bash infra/scripts/preview-cleanup.sh",
    "predeploy:staging": "npm run build:validators",
    "deploy:staging": "bash infra/scripts/deploy-staging.sh",
    "rollback:staging": "bash infra/scripts/rollback-staging.sh",
    "check:staging": "bash infra/scripts/post-deploy-check.sh",
    "seed:staging": "bash infra/scripts/seed-staging.sh",
    "secrets:staging": "bash infra/scripts/put-staging-secrets.sh",
    "secrets:staging:make": "bash infra/scripts/make-staging-secrets.sh",
    "check-tester:token:make": "node infra/scripts/make-check-tester-token.mjs",
    "hyperdrive:staging:create": "bash infra/scripts/create-staging-hyperdrive.sh"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261106.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "json-schema-to-typescript": "^15.0.4",
    "postgres": "^3.4.9",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "uqr": "0.1.3"
  }
}
