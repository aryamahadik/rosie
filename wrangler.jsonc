// Cloudflare Worker config (factory spec 6, ADR-008). Run wrangler only through infra/scripts/cf.sh (npm run cf),
// which uses the Rosfield sign-in and refuses any other account and any production target.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Top level: the production Worker. Unused in D-000: no production deploy script, workflow or secret exists.
  "name": "rosie",
  "account_id": "ecb06e7bc9129fa81104d331e9652362",
  "main": "runtime/src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Logs: where D-000's traces are read (search a trace id).
  "observability": {
    "enabled": true,
  },
  "workers_dev": true,
  // Needed for branch previews (wrangler versions upload --preview-alias).
  "preview_urls": true,
  // The HandleActor Durable Object (T-244 writes the class), for local runs; env.staging repeats it (T-566), and the
  // Vitest Workers pool runs env.staging. SQLite-backed, so the migration uses new_sqlite_classes.
  "durable_objects": {
    "bindings": [{ "name": "HANDLE_ACTOR", "class_name": "HandleActor" }],
  },
  "migrations": [{ "tag": "v1-handle-actor", "new_sqlite_classes": ["HandleActor"] }],
  // The bundle KV namespace (T-249 reads the step graph from it). The id is a local placeholder, enough for local
  // runs; env.staging names the real staging namespace (T-566).
  "kv_namespaces": [{ "binding": "BUNDLES", "id": "00000000000000000000000000000000" }],
  // The clock sweep's one-minute cron (C-021), for local runs; env.staging repeats it (T-566).
  "triggers": {
    "crons": ["* * * * *"],
  },
  // The retry queue (RETRY_QUEUE) with its dead-letter queue: 5 tries, then the message goes to rosie-retry-dlq.
  // For local runs; env.staging repeats it on the real rosie-retry and rosie-retry-dlq (T-566).
  "queues": {
    "producers": [{ "queue": "rosie-retry", "binding": "RETRY_QUEUE" }],
    "consumers": [{ "queue": "rosie-retry", "max_retries": 5, "dead_letter_queue": "rosie-retry-dlq" }],
  },
  // The private files bucket (FILES; the R2 adapter, T-438, reads and writes ID files through it; Master
  // Corrections C10). The bucket is rosie-staging-files, the only one that exists (infra/scripts/create-r2-bucket.sh
  // makes it with no public access: no r2.dev URL, no custom domain). For local runs and dry runs, which simulate it
  // without touching the real bucket. No env.staging copy yet: T-566's card names none, so the task that first uses
  // the bucket on staging adds it (NQ-RT-5).
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "rosie-staging-files" }],
  // No Hyperdrive binding yet: it comes with the task that needs it.
  // GIT_SHA is not listed: deploys set it with --var GIT_SHA:<sha>.
  "vars": {
    "ENVIRONMENT": "production",
    "BASE_PATH": "",
    "DB_SCHEMA": "",
  },
  // The secrets the Worker needs, by name. Only these reach local runs and tests from .dev.vars; none in D-000,
  // so keys stay out of tests (build prompt 5.1). Not inherited: repeated in each environment.
  "secrets": {
    "required": [],
  },
  "env": {
    "staging": {
      "name": "rosie-staging",
      // DB_SCHEMA stays empty on staging; each branch preview sets it to preview_<slug> at upload.
      "vars": {
        "ENVIRONMENT": "staging",
        "BASE_PATH": "/test",
        "DB_SCHEMA": "",
      },
      "secrets": {
        "required": [],
      },
      // Switched on Nov 6 2026 with the user's OK for staging to take over rosfield.com/test (DL-036).
      // Two exact patterns, so other site paths that merely start with "test" are not caught.
      "routes": [
        { "pattern": "rosfield.com/test", "zone_name": "rosfield.com" },
        { "pattern": "rosfield.com/test/*", "zone_name": "rosfield.com" },
      ],
      // The top level's bindings, repeated for staging (T-566), since wrangler does not pass bindings down to an
      // environment. infra/scripts/create-staging-bindings.sh made the KV namespace and both queues on the Rosfield
      // account through cf.sh; the deploy makes the HandleActor class (the top level's migration tag) and the cron.
      // The Vitest Workers pool runs this environment, so its tests get these bindings, simulated locally.
      // Staging alone also binds TEST_PHONE_LINE, the test-phone page's TestPhoneLine (T-1186, DL-379), with its own
      // migration tag: never at the top level or in env.production, which never wire the test-phone page (DL-373 gap d).
      "durable_objects": {
        "bindings": [
          { "name": "HANDLE_ACTOR", "class_name": "HandleActor" },
          { "name": "TEST_PHONE_LINE", "class_name": "TestPhoneLine" },
        ],
      },
      "migrations": [
        { "tag": "v1-handle-actor", "new_sqlite_classes": ["HandleActor"] },
        { "tag": "v2-test-phone-line", "new_sqlite_classes": ["TestPhoneLine"] },
      ],
      // rosie-staging-bundles, the staging bundle namespace (T-249's pin reads the step graph from it).
      "kv_namespaces": [{ "binding": "BUNDLES", "id": "17ea09bea3b1445fad51c02dc6f37210" }],
      // The clock sweep's minute (T-254).
      "triggers": {
        "crons": ["* * * * *"],
      },
      // The retries (T-256): 5 tries, then rosie-retry-dlq.
      "queues": {
        "producers": [{ "queue": "rosie-retry", "binding": "RETRY_QUEUE" }],
        "consumers": [{ "queue": "rosie-retry", "max_retries": 5, "dead_letter_queue": "rosie-retry-dlq" }],
      },
    },
    // The production environment (T-1003). Written, never deployed: no production deploy script, workflow or secret
    // exists, and nothing below is created on Cloudflare until the user says yes (Q-51: one account for now, so every
    // resource carries "production" in its name and none is shared with staging). Wrangler does not inherit bindings,
    // vars, migrations or secrets into an environment, so each is repeated here. account_id, main and the
    // compatibility settings are inherited from the top level (the Rosfield account stays pinned there).
    "production": {
      "name": "rosie-production",
      // Not reachable on a workers.dev address or a preview URL; production answers only on its route once approved.
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "production",
        "BASE_PATH": "",
        "DB_SCHEMA": "",
      },
      // Names only, no values. Live keys are set by the CTO from his own login at M8 (none exists before then).
      "secrets": {
        "required": [],
      },
      "durable_objects": {
        "bindings": [{ "name": "HANDLE_ACTOR", "class_name": "HandleActor" }],
      },
      "migrations": [{ "tag": "v1-handle-actor", "new_sqlite_classes": ["HandleActor"] }],
      // Placeholder id (not a real namespace): the CTO creates rosie-production-bundles and puts its id here.
      "kv_namespaces": [{ "binding": "BUNDLES", "id": "00000000000000000000000000000001" }],
      "triggers": {
        "crons": ["* * * * *"],
      },
      "queues": {
        "producers": [{ "queue": "rosie-production-retry", "binding": "RETRY_QUEUE" }],
        "consumers": [
          {
            "queue": "rosie-production-retry",
            "max_retries": 5,
            "dead_letter_queue": "rosie-production-retry-dlq",
          },
        ],
      },
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "rosie-production-files" }],
      // Placeholder id (not a real Hyperdrive configuration): the CTO creates rosie-production-hyperdrive (caching
      // off for decision reads, ADR-007) and puts its id here. The database password lives in that configuration,
      // never in this file.
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "00000000000000000000000000000002" }],
      // Production's route stays commented out until the user says yes. Do not uncomment it in a task; the lead
      // does that with the user's OK, together with the DNS check.
      // "routes": [
      //   { "pattern": "rosfield.com/<production path, set when approved>", "zone_name": "rosfield.com" },
      // ],
    },
  },
}
