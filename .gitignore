# The lead's own repository and the scratch space (build prompt 5.7, hard rule 2)
/ops/
/scratch/

# Keys never enter git (hard rule 7)
.env
.env.*
.dev.vars
.dev.vars.*

# Dependencies and tool output
node_modules/
coverage/
.wrangler/

# Contract types are generated in CI and never committed (ADR-005)
/contracts/generated/

# The Tool API's validators, compiled ahead of time from the contracts by `npm run build:validators` (T-1144):
# generated before lint, the type check, the tests and any Worker bundle, and never committed (ADR-005)
/actions/src/tool-api/generated/

# Claude Code: builder worktrees, personal settings and the lead session's lock files (the rest of .claude/ is
# committed by path)
/.claude/worktrees/
/.claude/settings.local.json
/.claude/scheduled_tasks.lock
/.claude/*.lock

# macOS
.DS_Store
