{
  // T-1329 (DL-612, DL-617): db/ is type-checked a second time, with erasableSyntaxOnly, so `npm run typecheck`
  // refuses there any syntax Node's type stripping cannot run (parameter properties, enums, namespaces, `import =`).
  // Node runs db/ straight from TypeScript, with no bundler (db/seeds/run.mjs, infra/flags/flags.mjs and the CI script
  // tests that load db/seeds and db/repo), and stops at such a line with ERR_UNSUPPORTED_TYPESCRIPT_SYNTAX (train 143).
  // The rest of the repository is bundled by wrangler or run by Vitest, whose transform runs that syntax, so the root
  // program (tsconfig.json) keeps it allowed there. Every other option is the root's.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "erasableSyntaxOnly": true
  },
  "include": ["**/*"]
}
