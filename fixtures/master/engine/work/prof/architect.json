  "pf.license": {
   "need": "An architect's state license, where the state requires one for the drawings. Each architect's own license, and the firm's registration where the state asks: the owner's own papers, shown as given, never checked by Rosie (D96).",
   "who holds it": "Each architect, as the owner says. The firm holds its registration where the state asks for one.",
   "how it's checked": "Not checked by Rosie. The owner keeps the papers.",
   "insurance or bond": "Professional liability insurance: the owner's own certificate, shown as given, never checked.",
   "blocks going live": "Nothing: Rosie shows no license claim for any architect.",
   "renewals": "The owner's own list; Rosie sends no reminder for a license it never checked.",
   "background checks": "None."
  },
  "pf.services": {
   "shape": "a design consult and review at the studio (flow A), and site visits and design work at the customer's place (flow B); a video or photo review counts as flow A",
   "price kind": "one price per visit or per phase, from the owner's own list; a travel fee on a site visit is part of the price shown; a design phase over $500 is OK'd by the owner first",
   "examples": "the example firm's own prices (Lee Design Studio, Lee Architects), not a standard",
   "list": [
    {
     "name": "Design consult at the studio, one room",
     "price": "$35",
     "kind": "one price",
     "length": "about 45 minutes",
     "where": "at the studio",
     "before": "a card saved for the $20 fee",
     "after": "paid at the front desk after the consult"
    },
    {
     "name": "Video design review, one room",
     "price": "$55, paid in full",
     "kind": "one price",
     "length": "about 30 minutes, by video, from photos of the room",
     "where": "by video (flow A)",
     "before": "paid in full when booking",
     "after": "nothing more"
    },
    {
     "name": "Schematic design review at the studio",
     "price": "$140",
     "kind": "one price per phase",
     "length": "1 to 2 hours",
     "where": "at the studio",
     "before": "a $40 deposit when booking",
     "after": "the $100 rest paid at the desk when the drawings are picked up"
    },
    {
     "name": "Design quoted from photos",
     "price": "quoted from photos first, e.g. $90",
     "kind": "quoted from photos",
     "where": "by photos and a call (flow A)",
     "before": "a $20 deposit once the quote is OK'd",
     "after": "the rest billed when the drawings are sent"
    },
    {
     "name": "Room look, one small room",
     "price": "$25",
     "kind": "one price",
     "where": "at the studio",
     "before": "paid at the desk",
     "after": "nothing more"
    },
    {
     "name": "Site survey (add-on, at a home visit)",
     "price": "$199",
     "kind": "one price",
     "where": "at the customer's place (flow B)",
     "before": "a card saved",
     "after": "the bill, with the rest of the visit"
    },
    {
     "name": "Home site visit and measure",
     "price": "$179, with the $89 travel fee",
     "kind": "one price",
     "where": "at the customer's place (flow B)",
     "before": "a card saved for the $89 fee",
     "after": "the bill texted after the visit"
    },
    {
     "name": "Design phase at home",
     "price": "$150",
     "where": "at the customer's place",
     "before": "a $40 deposit when booking",
     "after": "the $110 rest charged to the saved card when the architect texts DONE"
    },
    {
     "name": "Permit-drawing review at home",
     "price": "$75, paid in full",
     "where": "at the customer's place",
     "before": "paid in full when booking",
     "after": "nothing more"
    },
    {
     "name": "Whole-house design, quoted from photos",
     "price": "$640 quoted (over $500, so the owner OKs it)",
     "kind": "quoted from photos",
     "where": "at the customer's place",
     "before": "a $160 deposit once the proposal is signed",
     "after": "the $480 rest billed as the drawings are delivered"
    }
   ],
   "never designed": "No stamped drawings the architect is not licensed to stamp; no construction supervision the license doesn't cover; no legal advice on contracts.",
   "capacity": "one architect per visit; a second person from the team only when the owner books one",
   "online": "video and photo reviews only, where the owner allows them; Rosie never records a call or a video."
  },
  "pf.questions": {
   "before times": [
    "What kind of work: a room, a kitchen, an addition, a whole house, or a permit set?",
    "Is there a site plan, photos or a survey already? Yes, no or not sure.",
    "What's the goal: a new room, a sale, a permit, or repairs?",
    "At the studio, at the customer's place, or by video?"
   ],
   "after a time is picked": [
    "Where the work is and the rooms to see",
    "Parking or the building's sign-in"
   ],
   "only on the secure page": [
    "The street address and any gate code",
    "Who owns the property, and any HOA or landlord rules",
    "The budget range, if the customer wants to share it",
    "Permit and survey papers already on file"
   ],
   "who may book": "An adult who owns the property, or who has the owner's written permission. A design for a property the booker doesn't own needs that owner's yes."
  },
  "pf.safety": {
   "words that stop a booking": [
    "someone hurt, or a fire or smoke at the place (call 911)",
    "a structure that looks unsafe to stand in (call 911 if someone is in it)"
   ],
   "words that go on with safety steps": [
    "a site that needs a structural engineer before anyone goes in"
   ],
   "what Rosie says": {
    "in danger right now": "Call 911 now. Nothing is booked.",
    "unsafe structure": "The architect doesn't go into an unsafe site, and says so. A structural engineer is needed first."
   },
   "legal questions": "Never answered: an architect's advice on contracts or disputes is the owner's own."
  },
  "pf.first_steps": {
   "required": "None.",
   "prep for the reminder": [
    "Send the site plan, survey or photos before the visit, if there are any",
    "Clear the rooms to be measured",
    "Have the current permit papers or the HOA rules ready",
    "Note the rooms and the wish list"
   ]
  },
  "pf.visit": {
   "check-in": "At the studio: the code at the front desk. At a home: the code from whoever meets the architect.",
   "before measuring": "The architect measures each room and checks the site plan against the place, then notes what's needed for the design. Nothing is quoted in a text.",
   "work changes": "A change found on site is priced at the list price and OK'd by the owner before it's done.",
   "stops": "A structure that looks unsafe: the architect stops, leaves the site and says so.",
   "report": "Drawings and notes go to the owner on the secure page, with the next step."
  },
  "pf.money": {
   "before": "a card saved for the late-cancel fee at the studio; paid in full for video and one-room reviews; a deposit for each design phase",
   "after": "paid at the desk, the bill texted after a site visit, or the saved card charged at DONE",
   "cancel": "a cancel in time gets a full refund; a late cancel or no-show keeps the fee shown on the booking",
   "caps": "the owner's own limit: any design phase over $500 is OK'd by the owner first",
   "tips": "none: architects take no tips"
  },
  "pf.messages": "Texts go to the owner who booked. Design details and budgets are never in a text: the secure page only.",
  "pf.staff": {
   "skills": "architect (residential), designer, desk",
   "licenses": "the owner's own state license where the state requires one, shown as given",
   "ratio": "one architect per visit",
   "standIn": "any licensed architect on the team; nobody is booked by name",
   "oks": "Sam OKs any phase over $500 and any change to a signed design"
  },
  "pf.rules": {
   "no stamping": "The architect stamps only what the architect's own license covers.",
   "budgets": "A budget is in the design notes on the secure page, never in a text.",
   "limits": "A design phase over $500 needs the owner's yes first."
  },
  "pf.edges": {
   "walkins": "A walk-in takes a consult when there's a free slot; else the next free day.",
   "photos": "A photo quote needs clear photos of each room first; without them the architect asks for more."
  },
