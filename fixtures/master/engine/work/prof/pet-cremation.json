{
 "id": "pet-cremation",
 "name": "Pet cremation and pet cemetery",
 "style": "Consult",
 "pattern": "consult",
 "from": "funeral",
 "plugin": {
  "pf.license": {
   "need": "No state license for a pet cremation or pet cemetery in most places. Where the state or a city asks for a crematory permit or the business registration, the owner names it: shown as given, never checked by Rosie.",
   "who holds it": "The business and its owner, as the owner says. Staff hold no license Rosie checks.",
   "how it's checked": "Not checked by Rosie. The owner keeps the permits and the registration.",
   "insurance or bond": "Liability insurance: the owner's own certificate, shown as given, never checked.",
   "blocks going live": "Nothing: Rosie shows no license claim for the business.",
   "renewals": "The owner's own list; Rosie sends no reminder for a permit it never checked.",
   "background checks": "None."
  },
  "pf.services": {
   "shape": "a private cremation with a memorial garden (flow A: the family comes to the garden or drops the pet off); a home pick-up and cremation (flow B: the business goes to the family or the vet)",
   "price kind": "one price per pet, by the pet's weight, from the owner's own list; no travel fee and no extra fee: the pick-up is part of the price",
   "examples": "the example garden's own prices (Lee Pet Garden, Lee Pet Cremation), not a standard",
   "list": [
    {
     "name": "Urn chosen at the visit",
     "price": "$110, with an engraved plaque at $15 if the family wants one",
     "kind": "one price, chosen at the visit",
     "where": "at the garden (flow A)",
     "before": "nothing taken",
     "after": "paid at the desk only for what the family chooses"
    },
    {
     "name": "Garden visit, private",
     "price": "free",
     "kind": "free",
     "length": "about 30 minutes",
     "where": "at the garden (flow A)",
     "before": "nothing taken",
     "after": "nothing to pay; an urn or a plaque is chosen and paid at the desk only if the family wants one"
    },
    {
     "name": "Private cremation, up to 50 lb",
     "price": "$190",
     "kind": "one price per pet",
     "length": "the cremation takes a day; the ashes come back in an urn",
     "where": "at the garden (flow A)",
     "before": "paid in full when booking",
     "after": "nothing more"
    },
    {
     "name": "Drop-off cremation, at a set time",
     "price": "$190",
     "kind": "one price per pet",
     "where": "at the garden (flow A)",
     "before": "nothing taken",
     "after": "paid at the desk when the family collects the urn"
    },
    {
     "name": "Home pick-up and private cremation",
     "price": "$240, with the pick-up",
     "kind": "one price per pet",
     "where": "at the family's home or the vet's (flow B)",
     "before": "nothing taken",
     "after": "the bill texted after the ashes are returned"
    },
    {
     "name": "Home pick-up, paid in full",
     "price": "$240",
     "kind": "one price per pet",
     "where": "at the family's home (flow B)",
     "before": "paid in full when booking",
     "after": "nothing more"
    },
    {
     "name": "Home pick-up, paid the business's own way",
     "price": "$240",
     "kind": "one price per pet",
     "where": "at the family's home (flow B)",
     "before": "nothing taken",
     "after": "paid at the return of the ashes, cash or check"
    }
   ],
   "never sold": "No upsell and no sales talk. Urns, plaques and keepsakes are shown only when the family asks, from the owner's list, at the family's pace.",
   "capacity": "one pet per cremation; a pick-up takes one trip",
   "online": "booked by text or the secure page; the family can always call the garden instead."
  },
  "pf.questions": {
   "before times": [
    "What kind of pet, and about how much does it weigh?",
    "Where is the pet now: at home, at a vet's, or at the garden?",
    "Would the family like a visit to the garden first, or a pick-up?",
    "Is a same-day pick-up needed? Yes, no or not sure."
   ],
   "after a time is picked": [
    "Where the pet is, and a way in (a gate, a side door)",
    "Anyone else who will be there, if the family wants them to be"
   ],
   "only on the secure page": [
    "The family's address and any gate code",
    "The name of the pet, and the family's own words about it",
    "Any ashes or memorial wishes",
    "The vet's name, if the pet came from a clinic",
    "Who is the owner of the pet, and anyone else with a say"
   ],
   "who may book": "An adult in the family, or someone the family asks to book for them. A pet is always booked by an adult who may decide for it."
  },
  "pf.safety": {
   "words that stop a booking": [
    "someone in danger right now (call 911)"
   ],
   "words that go on with safety steps": [
    "a family member who is very upset or unwell: the booking goes on, and the garden is told so it can call the family"
   ],
   "what Rosie says": {
    "in danger right now": "Call 911 now. Nothing is booked.",
    "upset family": "Rosie is gentle, says the garden will call, and doesn't ask for details now."
   },
   "legal questions": "Never answered: Rosie gives no advice on the law, the death, or a pet's remains beyond the garden's own steps."
  },
  "pf.first_steps": {
   "required": "None.",
   "prep for the reminder": [
    "The pet's name and a photo, if the family likes",
    "A blanket or towel for the pet, if the family wants to send one",
    "A way to reach the family on the day, and a gate or door code",
    "Any wishes for the ashes, written down"
   ]
  },
  "pf.visit": {
   "check-in": "At the garden: the code at the front desk, given quietly. At a home: the code from whoever meets the crew.",
   "before the cremation": "The garden confirms the pet's name and weight with the family, then records the pet's care on the secure page. Nothing is shown to anyone else.",
   "after the cremation": "The ashes are returned in the urn the family chose, with the paperwork, on the family's own schedule.",
   "stops": "A family member asks to stop or change anything: the garden stops, and asks what they need, with no pressure."
  },
  "pf.money": {
   "before": "nothing taken for a visit; a private cremation paid in full when booking; a drop-off or home pick-up with nothing taken before",
   "after": "paid at the desk when the urn is collected, the bill texted after the ashes are returned, or the family's own way at a home pick-up",
   "cancel": "no fee to cancel or move a pick-up, a cremation or a visit; a family that needs more time can always move it",
   "caps": "none: no fee of any kind is added",
   "tips": "none: staff take no tips"
  },
  "pf.messages": "Texts are gentle and short. The pet's name, the family's words, any health detail and any price are never in a text: the secure page only.",
  "pf.staff": {
   "skills": "garden staff (visits and keepsakes), pick-up drivers (home pick-ups and the vet's), crematory operator",
   "licenses": "none from the state for the staff; the crematory permit the owner names, shown as given",
   "ratio": "one pick-up team per trip; two people at a home pick-up when the family asks",
   "standIn": "any trained staff member; nobody is booked by name",
   "oks": "Sam OKs any special request and any change to a booking the family has made"
  },
  "pf.rules": {
   "no fees": "No fee is added to any booking, at any time; a cancelled visit or pick-up costs nothing.",
   "no sales": "No upsell. Urns and keepsakes appear only when the family asks, at the family's pace.",
   "privacy": "A family's grief is never mentioned in a text. Details stay on the secure page."
  },
  "pf.edges": {
   "nightPickups": "A same-day pick-up at night is sent when the family asks, with the crew's first arrival window.",
   "walkins": "A family who comes to the garden without a booking is seen when a staff member is free; no one is turned away."
  },
  "pf.facts": [
   "documents",
   "sentnow"
  ],
  "pf.switches": {
   "sensitive": true
  },
