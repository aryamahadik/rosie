        },
        "chat": {
          "$ref": "data-access.v1.2.schema.json#/$defs/sendState.response/properties/chat"
        },
        "textsConsent": {
          "description": "The newest texts consent row for this contact that covers the row's business, its business's or every business's (K-29 v1 consents_handle_kind_at_idx: 'limit 8's texts check read a contact's newest texts row'; RULES 7.1, 7.2; K-05 v1.2 default 35), by at, a tie to the lower id, with who gave it and for which booking (v1.8: fromContact, bookingId); null when there is none. For an email contact it is the stop record, since only a phone carries the stopped flag. Changed in v1.8.",
          "anyOf": [
            {
              "$ref": "#/$defs/textsConsentRead"
