          "$ref": "data-access.v1.2.schema.json#/$defs/sendState.response/properties/textHoursOverride"
        },
        "currentVersions": {
          "$ref": "data-access.v1.2.schema.json#/$defs/sendState.response/properties/currentVersions"
        },
        "booking": {
          "$ref": "data-access.v1.2.schema.json#/$defs/sendState.response/properties/booking"
