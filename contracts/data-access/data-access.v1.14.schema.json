    "claimOutbox.request": {
      "title": "ClaimOutboxRequest",
      "description": "Claim each recipient's next sendable outbox rows in commit order, so no row is sent twice; a row held for text hours lets later rows pass (arch 02 line 125, DD; 02-contracts K-05 item 3). One recipient (the actor's own after a commit) or, with no recipient, any recipients with sendable rows (the dispatcher's sweep): README items 3, 13, 30 and 64. v1.14 (T-1353; README item 67) adds sendClass, the safety-only claim, made for a named recipient alone (refuse-claim-safety-no-recipient). Restated in v1.14 only to take it: without it the request is v1's and the claim v1.13's, unchanged. Changed in v1.14.",
      "type": "object",
      "properties": {
        "claimer": {
          "description": "The dispatcher instance making the claim, for traces (BP 5.5).",
          "$ref": "#/$defs/id"
        },
        "recipientHandleId": {
          "description": "One recipient's handle; left out: any recipients. Required with sendClass.",
          "$ref": "#/$defs/id"
        },
        "now": {
          "description": "The time held rows are compared with (K-04 outbox_rows.held_until).",
          "$ref": "#/$defs/utc"
        },
        "limit": {
          "description": "At most this many rows in all. A claim with sendClass takes safety rows alone, so only they count toward it.",
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "sendClass": {
          "description": "safety, its only value (refuse-claim-safety-other-class): the claim of a danger line's own wake (T-1352; DL-687), for the named recipient only (README item 67). It takes item 3's recipient lock in its blocking form, so it waits for another claim's walk of that recipient and is never skipped; under the lock it reads only the recipient's open rows of send class safety (K-04 outbox_rows.send_class), FOR UPDATE in commit_seq order, claims each it can (checked; held with held_until at or before now; sending with a lapsed claim or none, under its stored keys) and passes each it cannot (sending with a live claim, waiting_chat, planned or stale, held not yet due), with the same moves, keys and claim rows as items 3 and 13. It never reads, locks, stops at, waits for or counts a row of another class. Left out: v1.13's claim of every class, unchanged. New in v1.14.",
          "const": "safety"
        }
      },
      "required": ["claimer", "now", "limit"],
      "dependentRequired": { "sendClass": ["recipientHandleId"] },
      "additionalProperties": false
    },
    "claimedPart": { "$ref": "data-access.v1.13.schema.json#/$defs/claimedPart" },
    "claimedRow": { "$ref": "data-access.v1.13.schema.json#/$defs/claimedRow" },
    "claimOutbox.response": { "$ref": "data-access.v1.13.schema.json#/$defs/claimOutbox.response" },
    "claimOutbox.errors": { "$ref": "data-access.v1.13.schema.json#/$defs/claimOutbox.errors" },
    "claimOutbox.exchange": {
      "title": "ClaimOutboxExchange",
      "description": "One claimOutbox request with its outcome, restated in v1.14 to refer to v1.14's claimOutbox.request and to hold a safety claim's answer to README item 67: with sendClass safety, each claimed row is of send class safety (refuse-safety-claim-takes-routine-row) and states its claim, claimedFrom, port, emailPurpose and notAfter (a v1.14 call is a v1.13 call, which always writes them: item 64), and passedHeld is empty (refuse-safety-claim-lists-held-row), since the walk reads no row of another class and passes a safety row held ahead without listing it (default 131). That every claimed row is the named recipient's, and that there are at most limit of them, are rules the schema cannot hold (item 67). Without sendClass the exchange is v1.13's. Changed in v1.14.",
      "type": "object",
      "properties": {
        "call": { "const": "claimOutbox" },
        "given": { "$ref": "#/$defs/given" },
        "request": { "$ref": "#/$defs/claimOutbox.request" },
        "outcome": {
          "anyOf": [{ "$ref": "#/$defs/claimOutbox.response" }, { "$ref": "#/$defs/claimOutbox.errors" }]
        }
      },
      "required": ["call", "given", "request", "outcome"],
      "additionalProperties": false,
      "if": {
        "type": "object",
        "properties": {
          "request": {
            "type": "object",
            "properties": { "sendClass": { "const": "safety" } },
            "required": ["sendClass"]
          }
        },
        "required": ["request"]
      },
      "then": {
        "type": "object",
        "properties": {
          "outcome": {
            "if": {
              "type": "object",
              "properties": { "result": { "const": "claimed" } },
              "required": ["result"]
            },
            "then": {
              "type": "object",
              "properties": {
                "claimed": {
                  "description": "The named recipient's safety rows the walk took, in commit order, at most limit of them: never a row of another class (README item 67).",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": { "sendClass": { "const": "safety" } },
                    "required": ["sendClass", "claim", "claimedFrom", "port", "emailPurpose", "notAfter"]
                  }
                },
                "passedHeld": {
                  "description": "Empty: a safety claim lists no row it passed (README item 67; default 131).",
                  "type": "array",
                  "maxItems": 0
                }
              }
            }
          }
        }
      }
    },
