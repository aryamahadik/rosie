          "anyOf": [
            { "$ref": "#/$defs/readTesterStanding.response" },
            { "$ref": "#/$defs/readTesterStanding.errors" }
          ]
        }
      },
      "required": ["call", "given", "request", "outcome"],
      "additionalProperties": false
    },
