    "signedInRole": { "$ref": "data-access.v1.14.schema.json#/$defs/signedInRole" },
    "personStanding.response": {
      "title": "PersonStandingResponse",
      "description": "The person's standing (README items 62 and 69): their live roles, whether they are on Rosie's team and whether they are a tester, as the rows say; the page call gives tester false outside staging (K-21 v1 schema line 853), and on a read that fails answers roles empty and both flags false, failing closed (ADR-016 section 6). Never a session, a hash, a contact, a name, or which row made the person a tester. A team member is a tester, so team true never comes with tester false (refuse-person-standing-team-not-tester); a listed human tester is a tester with no team row, team false and tester true (README item 69; default 137). Restated in v1.15 for tester's text and that rule: the shape is v1.13's. Changed in v1.15.",
      "type": "object",
      "properties": {
        "personId": { "$ref": "#/$defs/id" },
        "roles": {
          "description": "K-04 person_roles of the person with ended_at null, but customer, at every business, in role id order (as db/repo/people.ts reads live roles).",
          "type": "array",
          "items": { "$ref": "#/$defs/signedInRole" }
        },
        "team": {
          "description": "true when the person holds a live K-36 v1 team_page_recipients row (removed_at null): Rosie's team (K-21 v1 signedIn.person.team; Q-18). A K-22 v1.3 staging_testers listing is no team row, so a human tester's is false (ADR-016 section 5: 'person.team ... false for them'; README default 137).",
          "type": "boolean"
        },
        "tester": {
          "description": "true when the person holds a live K-36 v1 team_page_recipients row or a live K-22 v1.3 staging_testers listing (removed_at null for either), read by person as v1.15's readTesterStanding reads them (README item 69, default 136; open gap 62, closed by v1.15).",
          "type": "boolean"
        }
      },
      "required": ["personId", "roles", "team", "tester"],
      "additionalProperties": false,
      "if": {
        "type": "object",
        "properties": { "team": { "const": true } },
        "required": ["team"]
      },
      "then": {
        "type": "object",
        "properties": { "tester": { "const": true } },
        "required": ["tester"]
      }
    },
    "personStanding.errors": { "$ref": "data-access.v1.14.schema.json#/$defs/personStanding.errors" },
    "personStanding.exchange": {
      "title": "PersonStandingExchange",
      "description": "One personStanding request with its outcome. Restated in v1.15 only to refer to v1.15's personStanding.response. Changed in v1.15.",
      "type": "object",
      "properties": {
        "call": { "const": "personStanding" },
        "given": { "$ref": "#/$defs/given" },
        "request": { "$ref": "#/$defs/personStanding.request" },
        "outcome": {
          "anyOf": [
            { "$ref": "#/$defs/personStanding.response" },
            { "$ref": "#/$defs/personStanding.errors" }
          ]
        }
      },
      "required": ["call", "given", "request", "outcome"],
      "additionalProperties": false
    },
