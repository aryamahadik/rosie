    "readTesterStanding.request": {
      "title": "ReadTesterStandingRequest",
      "description": "The standing of the session a staging page call carries, for staging's test tools (README items 53 and 68; actions/src/page-calls/staging/test-phone/types.ts TesterAccess.standing; K-21 v1 README 'Staging only': 'a signed-in roster tester or a person on Rosie's team'). The page entry sends it after a request with a session token, before the roster or the phone is read (handlers.ts step 3). The request carries the token's sha256 and the time, never the token (refuse-tester-standing-token-not-hash), a person, or an address the testers' list could be searched by (refuse-tester-standing-by-address): the list is read by the session's person alone. Scope: the runtime side, as rosie_job with no business scope (K-22 v1 sessions, K-22 v1.3 staging_testers and K-36 v1 team_page_recipients are scoped none, and neither list grants rosie_app anything: 0017; K-22 v1.3 rule 10). Reads the primary, uncached: a session that ended, a team row removed or a listing ended ends the standing at once. Repeat: safe, a read. Time budget: none in the sources; once per staging test-tool call. Restated in v1.15 for its text alone: the shape is v1.12's. Changed in v1.15.",
      "type": "object",
      "properties": {
        "tokenSha256": {
          "description": "The sha256 of the session token the page sent (K-21 v1 signedInPage.sessionToken), never the token itself.",
          "$ref": "#/$defs/tokenSha256"
        },
        "at": {
          "description": "The moment the session must be live at: the page entry's own clock (handlers.ts: utcSeconds(now)), K-22 v1 session_for_token's at.",
          "$ref": "#/$defs/utc"
        }
      },
      "required": ["tokenSha256", "at"],
      "additionalProperties": false
    },
    "readTesterStanding.response": {
      "title": "ReadTesterStandingResponse",
      "description": "The standing alone (README items 53 and 68; defaults 103, 104 and 136 to 138): never the session, the person, a hash, which row admitted the person, whether a person, a team row or a listing exists, or whether or when a listing ended, so a call that is no tester's learns only notTester (refuse-tester-standing-names-person; refuse-tester-standing-ended-listing-told), and a call with no live session only noSession (K-21 v1 notTester, signInNeeded). Restated in v1.15 for standing's text alone: the shape is v1.12's. Changed in v1.15.",
      "type": "object",
      "properties": {
        "standing": {
          "description": "tester: a live session (K-22 v1 session_for_token answers a row) whose person holds a live K-36 v1 team_page_recipients row or a live K-22 v1.3 staging_testers listing, removed_at null for either (README item 68; defaults 103 and 136); notTester: a live session whose person holds neither, a listing that ended included; noSession: no live session has the hash at the time, whether the hash is unknown, the session ended (signed out, contact changed, left, handed over) or it expired (README default 104).",
          "type": "string",
          "enum": ["tester", "notTester", "noSession"]
        }
      },
      "required": ["standing"],
      "additionalProperties": false
    },
    "readTesterStanding.errors": { "$ref": "data-access.v1.14.schema.json#/$defs/readTesterStanding.errors" },
    "readTesterStanding.exchange": {
      "title": "ReadTesterStandingExchange",
      "description": "One readTesterStanding request with its outcome: the standing, or transient. Restated in v1.15 only to refer to v1.15's request and response. Changed in v1.15.",
      "type": "object",
      "properties": {
        "call": { "const": "readTesterStanding" },
