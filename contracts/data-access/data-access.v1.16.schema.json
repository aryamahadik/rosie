    "readOutboxRowWritten.response": {
      "title": "ReadOutboxRowWrittenResponse",
      "description": "Whether an outbox row with this id is written, as one read of the primary saw it under the call's scope (README items 41 and 70), and for a written row the recipient and send class its row stores: v1.4's five fields, each by reference to v1.4's own definition of it, which v1.5 to v1.15 keep unchanged, with two fields more (v1.16, T-1391): recipientHandleId and sendClass, each a value exactly when written is true and null exactly when it is false (a row not written, another business's, or one with a business read with businessId null: nothing of it reaches the caller, not even whom it goes to), and both or neither. They are optional here only so that every v1.4 to v1.15 answer, which has neither, is a v1.16 answer and every earlier exchange a v1.16 exchange: a v1.16 call always writes both (readOutboxRowWritten.v1dot16Response), and a consumer never reads an answer without them as a row with no recipient (README default 144). Never the row's words (its plan or final parts: refuse-outbox-row-written-returns-words stays refused), a number or an address, or any other column (README defaults 141 and 142). Changed in v1.16.",
      "type": "object",
      "properties": {
        "result": {
          "$ref": "data-access.v1.4.schema.json#/$defs/readOutboxRowWritten.response/properties/result"
        },
        "outboxRowId": {
          "$ref": "data-access.v1.4.schema.json#/$defs/readOutboxRowWritten.response/properties/outboxRowId"
        },
        "businessId": {
          "$ref": "data-access.v1.4.schema.json#/$defs/readOutboxRowWritten.response/properties/businessId"
        },
        "readAt": {
          "$ref": "data-access.v1.4.schema.json#/$defs/readOutboxRowWritten.response/properties/readAt"
        },
        "written": {
          "$ref": "data-access.v1.4.schema.json#/$defs/readOutboxRowWritten.response/properties/written"
        },
        "recipientHandleId": {
          "description": "The handle the written row goes to, as the row stores it (K-04 v1 outbox_rows.recipient_handle_id, not null on every row: migration 0010): a handle's id, never the raw number or address (K-08 v1 handleRef; refuse-outbox-row-written-recipient-number), read from the row alone, never from handles, the reach card or the owner read (README defaults 140 and 142). An email row's recipient is the email handle's id. Null exactly when written is false (refuse-outbox-row-written-no-recipient; refuse-outbox-row-written-other-business-recipient). New in v1.16.",
          "anyOf": [
            { "$ref": "../event-trace/event-trace.v1.schema.json#/$defs/handleRef" },
            { "type": "null" }
          ]
        },
        "sendClass": {
          "description": "The written row's send class, as the row stores it (K-04 v1 outbox_rows.send_class, not null on every row, outbox_rows_send_class_known: routine, quick_reply, visit_now or safety), which tells a danger line's wake whether its safety-only claim takes the row (K-05 v1.14 item 67). Null exactly when written is false. New in v1.16.",
          "anyOf": [{ "$ref": "#/$defs/sendClass" }, { "type": "null" }]
        }
      },
      "required": ["result", "outboxRowId", "businessId", "readAt", "written"],
      "additionalProperties": false,
      "dependentRequired": {
        "recipientHandleId": ["sendClass"],
        "sendClass": ["recipientHandleId"]
      },
      "if": {
        "type": "object",
        "properties": { "written": { "const": true } },
        "required": ["written"]
      },
      "then": {
        "type": "object",
        "properties": {
          "recipientHandleId": { "$ref": "../event-trace/event-trace.v1.schema.json#/$defs/handleRef" },
          "sendClass": { "$ref": "#/$defs/sendClass" }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "recipientHandleId": { "type": "null" },
          "sendClass": { "type": "null" }
        }
      }
    },
    "readOutboxRowWritten.v1dot16Response": {
      "title": "ReadOutboxRowWrittenV1dot16Response",
      "description": "readOutboxRowWritten's answer as a v1.16 call writes it (README item 70): every field of readOutboxRowWritten.response, by reference, with recipientHandleId and sendClass always stated, a handle's id and a send class for a written row, both null for a row the scope does not show, never left out. readOutboxRowWritten.response takes them as optional only so that v1.4 to v1.15's answers stay valid; this is the definition a v1.16 producer's answers are checked against (db/repo's readOutboxRowWritten, T-1161's read widened), so no consumer meets a v1.16 answer that leaves them out (README default 144). New in v1.16.",
      "type": "object",
      "properties": {
        "result": { "$ref": "#/$defs/readOutboxRowWritten.response/properties/result" },
        "outboxRowId": { "$ref": "#/$defs/readOutboxRowWritten.response/properties/outboxRowId" },
        "businessId": { "$ref": "#/$defs/readOutboxRowWritten.response/properties/businessId" },
        "readAt": { "$ref": "#/$defs/readOutboxRowWritten.response/properties/readAt" },
        "written": { "$ref": "#/$defs/readOutboxRowWritten.response/properties/written" },
        "recipientHandleId": { "$ref": "#/$defs/readOutboxRowWritten.response/properties/recipientHandleId" },
        "sendClass": { "$ref": "#/$defs/readOutboxRowWritten.response/properties/sendClass" }
      },
      "required": [
        "result",
        "outboxRowId",
        "businessId",
        "readAt",
        "written",
        "recipientHandleId",
        "sendClass"
      ],
      "additionalProperties": false,
      "if": {
        "type": "object",
        "properties": { "written": { "const": true } },
        "required": ["written"]
      },
      "then": {
        "type": "object",
        "properties": {
          "recipientHandleId": { "$ref": "../event-trace/event-trace.v1.schema.json#/$defs/handleRef" },
          "sendClass": { "$ref": "#/$defs/sendClass" }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "recipientHandleId": { "type": "null" },
          "sendClass": { "type": "null" }
        }
      }
    },
    "readOutboxRowWritten.errors": {
