    },
    "readOutboxRowWritten.exchange": {
      "title": "ReadOutboxRowWrittenExchange",
      "description": "One readOutboxRowWritten request with its outcome, as v1.4: v1.4's request, an answer, or one of v1.4's errors (notFound, transient), unchanged. The answer a v1.16 call gives is readOutboxRowWritten.v1dot16Response, recipientHandleId and sendClass always among its fields (README item 70); readOutboxRowWritten.response, which takes them as optional, also takes an answer of v1.4 to v1.15, so every v1.4 to v1.15 exchange is a v1.16 exchange. The two answer branches overlap, which anyOf allows: the first names what a v1.16 producer writes. Changed in v1.16.",
      "type": "object",
      "properties": {
        "call": { "const": "readOutboxRowWritten" },
        "given": { "$ref": "#/$defs/given" },
        "request": { "$ref": "#/$defs/readOutboxRowWritten.request" },
        "outcome": {
          "anyOf": [
            { "$ref": "#/$defs/readOutboxRowWritten.v1dot16Response" },
            { "$ref": "#/$defs/readOutboxRowWritten.response" },
            { "$ref": "#/$defs/readOutboxRowWritten.errors" }
          ]
        }
      },
      "required": ["call", "given", "request", "outcome"],
