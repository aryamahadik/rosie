    "phoneRowByHandleId": {
      "title": "PhoneRowByHandleId",
      "description": "One row reference that a commit whose request asks (answerPhoneRowsBy handleId) answers, narrowed (README item 71): a phones row is named by its handle id, K-04 v1 phones.handle_id (not null and unique: phones_handle_key, migration 0004), read from the row the commit locked or wrote, never by a second read, never looked up in handles by the number and never built from it (README defaults 145 and 146). So its rowId is a K-08 v1 handleRef, whose safeId refuses a +, an @, a space and a run of seven or more digits and phone punctuation (K-08 v1 default 3: a phone row by its handle id, never its number), and never has phoneNumber's shape (refuse-commit-alex-stop-answers-number). A row of any other table keeps its primary key as text, as rowRef says. It adds no field and changes no shape: the rowRef or changedRow it narrows keeps its own fields, required list and closed shape. The rowId answered is a name, never a key: no request accepts it (README item 71). New in v1.17.",
      "type": "object",
      "if": {
        "type": "object",
        "properties": { "table": { "const": "phones" } },
        "required": ["table"]
      },
      "then": {
        "type": "object",
        "properties": {
          "rowId": {
            "allOf": [
              { "$ref": "../event-trace/event-trace.v1.schema.json#/$defs/handleRef" },
              { "not": { "$ref": "#/$defs/phoneNumber" } }
            ]
          }
        }
      }
    },
    "commitTurn.request": {
      "title": "CommitTurnRequest",
      "description": "Commit a turn: the gate has passed limits 1 to 6, and one transaction writes the turn row (committed), the state, open questions, clock rows, outbox rows, reservations and the event log under the turn id, all or nothing, once (arch 01 lines 39 to 41; arch 02 line 121; arch 10 line 508; 02-contracts K-05 item 1). v1.1 (T-071): its writes may also hold effects and waitingChat (writes). v1.17 (T-1418; README item 71) adds answerPhoneRowsBy, which changes only what the call answers. Restated in v1.17 only to take it: turn, versionsRead and writes are v1.1's own, each by reference to v1.1's definition of it, which v1.2 to v1.16 keep unchanged, so without the field the request is v1.16's. Changed in v1.17.",
      "type": "object",
      "properties": {
        "turn": { "$ref": "data-access.v1.1.schema.json#/$defs/commitTurn.request/properties/turn" },
        "versionsRead": {
          "$ref": "data-access.v1.1.schema.json#/$defs/commitTurn.request/properties/versionsRead"
        },
        "writes": { "$ref": "data-access.v1.1.schema.json#/$defs/commitTurn.request/properties/writes" },
        "answerPhoneRowsBy": {
          "description": "handleId, its only value: every row reference the call answers names a phones row by its handle id (K-04 v1 phones.handle_id), never by its number, read from the row the commit locked or wrote and never by a second read; a phones row with no handle id throws, and the number is never answered in its place; every other table's row keeps its primary key as text (README item 71; commitTurn.exchange holds the answer to it). It changes nothing but the answer: the request still names a phones row by its number (versionsRead, a state update's key, an outbox row's and an open question's versionsRead), and the locks, the compares and the writes use it. A handle id where a request names a phones row names no row, so the call throws and writes nothing (it fails closed). Left out: the call answers as v1.16, byte for byte. Every turn's commit sets it (actions/src/commit/build.ts buildCommitRequest, from T-1419). New in v1.17.",
          "const": "handleId"
        }
      },
      "required": ["turn", "versionsRead", "writes"],
      "additionalProperties": false
    },
    "commitTurn.response": { "$ref": "data-access.v1.16.schema.json#/$defs/commitTurn.response" },
    "commitTurn.errors": { "$ref": "data-access.v1.16.schema.json#/$defs/commitTurn.errors" },
    "commitTurn.exchange": {
      "title": "CommitTurnExchange",
      "description": "One commitTurn request with its outcome, restated in v1.17 to refer to v1.17's commitTurn.request and to hold the answer of a request that asks to README item 71: with answerPhoneRowsBy handleId, every row reference the outcome names (committed.written, committed.waitingChat's superseded and withdrawn, and versionChanged's changed) is a phoneRowByHandleId, so no answered phones rowId has phoneNumber's shape or is a number in any form (refuse-commit-alex-stop-answers-number). wrongState's rowId never names a phones row (its table is outbox_rows, outbox_parts or effects: v1.1 wrongStateError, unchanged since, and commitTurn answers it only for an effect let go that is not in outage), and reservationLost, turnParked, constraint and transient name none; promoted keeps v1's forPhoneNumber (README open gap 79). call, given and outcome are v1.1's own, by reference, so without the field the exchange is v1.16's. Changed in v1.17.",
      "type": "object",
      "properties": {
        "call": { "$ref": "data-access.v1.1.schema.json#/$defs/commitTurn.exchange/properties/call" },
        "given": { "$ref": "data-access.v1.1.schema.json#/$defs/commitTurn.exchange/properties/given" },
        "request": { "$ref": "#/$defs/commitTurn.request" },
        "outcome": { "$ref": "data-access.v1.1.schema.json#/$defs/commitTurn.exchange/properties/outcome" }
      },
      "required": ["call", "given", "request", "outcome"],
      "additionalProperties": false,
      "if": {
        "type": "object",
        "properties": {
          "request": {
            "type": "object",
            "properties": { "answerPhoneRowsBy": { "const": "handleId" } },
            "required": ["answerPhoneRowsBy"]
          }
        },
        "required": ["request"]
      },
      "then": {
        "type": "object",
        "properties": {
          "outcome": {
            "type": "object",
            "properties": {
              "committed": {
                "type": "object",
                "properties": {
                  "written": { "type": "array", "items": { "$ref": "#/$defs/phoneRowByHandleId" } },
                  "waitingChat": {
                    "type": "object",
                    "properties": {
                      "superseded": { "type": "array", "items": { "$ref": "#/$defs/phoneRowByHandleId" } },
                      "withdrawn": { "type": "array", "items": { "$ref": "#/$defs/phoneRowByHandleId" } }
                    }
                  }
                }
              },
              "changed": { "type": "array", "items": { "$ref": "#/$defs/phoneRowByHandleId" } }
            }
          }
        }
      }
    },
    "commitTurn.handleIdExchange": {
      "title": "CommitTurnHandleIdExchange",
      "description": "The exchange of a commit whose request asks for phones rows by handle id: commitTurn.exchange narrowed by allOf to a request that carries answerPhoneRowsBy (README item 71), as chatOpenedEvent narrows eventEntry (README 'v1.7'). commitTurn.exchange holds such a request's answer to the rule, so here no answered phones rowId has phoneNumber's shape: committed.written's and versionChanged's phones rows are named by their handle ids. The v1.17 fixtures are listed under this definition, so the loops that select commitTurn.exchange (db/repo/commit-turn.int.test.ts COMMIT_ENTRIES) never meet them; it is the definition a producer's answers to a request that asks are checked against (db/repo's commitTurn, T-1417 round 2) and a caller that sets the field checks its exchanges by (T-1419). New in v1.17.",
      "allOf": [
        { "$ref": "#/$defs/commitTurn.exchange" },
        {
          "type": "object",
          "properties": {
            "request": { "type": "object", "required": ["answerPhoneRowsBy"] }
          },
          "required": ["request"]
        }
      ]
    },
