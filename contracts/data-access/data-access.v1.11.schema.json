    "readTurnParty.request": {
      "title": "ReadTurnPartyRequest",
      "description": "The handle's party for a turn (README item 52; runtime/src/turn/types.ts TurnDirectory.partyOf and TurnParty; the D-017 path audit's R3; T-1240's card, its first read; QUESTIONS.md CQ-220): the K-04 id of the handle whose texts a turn runs, the business the turn's Tool API calls run under (K-09 v1 caller.businessId), the person (caller.personId) and the zone the texts' dates resolve in (K-02 v1 text.sentAt.zone; S13-03). The handle actor (C-046) sends it once per run of a turn, before the texts are opened (runtime/src/turn/turn.ts), and once at a park (runtime/src/turn/park.ts), naming the handle its texts came from, as the gateway sealed them into the actor (K-06 v1 handle). The request names the handle alone: the business, the person and the zone are read from the rows, never handed in (refuse-turn-party-caller-business). Scope: the runtime side, as rosie_job with no business scope, the guard's side (K-04 v1 rule 4: the jobs that work across businesses by handle), since the read must see every business's roles and companies of the handle's people to know whether they name one business, and handles and person_handles are tables only rosie_job reads (0012). Reads the primary, uncached (arch 02 line 117: decision reads). Repeat: safe, a read. Time budget: none in the sources; it runs before a turn's texts are opened. New in v1.11.",
      "type": "object",
      "properties": {
        "handle": {
          "description": "The handle the turn's texts came from, as K-04 handles stores it (K-06 v1 handle: its kind, and an E.164 number or a lower-case email address, handles_address_form). Read on the runtime side alone, and never logged or put in a span, an error or an entry (rule 7).",
          "$ref": "../inbound-event/inbound-event.v1.schema.json#/$defs/handle"
        }
      },
      "required": ["handle"],
      "additionalProperties": false
    },
    "readTurnParty.atBusiness": {
      "title": "ReadTurnPartyAtBusiness",
      "description": "The handle's party when the rows give exactly one business its people may act for (README item 52, defaults 98 and 99): the handle's K-04 id, that business, the person when the handle has exactly one (default 97), and that business's zone. The turn's calls run under that business (K-09 v1 caller.businessId; arch 10 line 546). New in v1.11.",
      "type": "object",
      "properties": {
        "handleId": {
          "description": "K-04 handles.id of the handle the request names (K-08 v1 handleRef): the turn row's handle, and the handle the guard reads the targets of.",
          "$ref": "../event-trace/event-trace.v1.schema.json#/$defs/handleRef"
        },
        "businessId": {
          "description": "The one business the handle's people act for: the business of their live roles (K-04 person_roles with ended_at null), or the business of the company one of them owns while the rows agree it is theirs (K-23 companies.business_id; README defaults 98 and 99).",
          "$ref": "#/$defs/id"
        },
        "personId": {
          "description": "K-04 person_handles.person_id when the handle has exactly one person; null when it has none or several (S13-27 rule 28: 'One phone can be several people'; K-09 v1 caller.personId, 'when known'; README default 97).",
          "$ref": "#/$defs/nullableId"
        },
        "zone": {
          "description": "K-04 businesses.time_zone of that business: the zone the turn's texts' dates resolve in (S13-03: 'a visit at the business uses the business's time zone'; CQ-05; README default 101).",
          "$ref": "#/$defs/zone"
        }
      },
      "required": ["handleId", "businessId", "personId", "zone"],
      "additionalProperties": false
    },
    "readTurnParty.noBusiness": {
      "title": "ReadTurnPartyNoBusiness",
      "description": "The handle's party when its people act for no business: none of them holds a live role or owns a company, or each company they own has no business yet (K-23 README rule 5: sign-up between S1-04 and S1-09; README default 98). The turn's calls run with no business, on the runtime side, and see only rows with no business (K-09 v1 caller.businessId: 'Null only where no business exists yet'; K-05 v1.2 default 25). The zone is null, since no row gives one; the consumer reads the texts' dates in UTC (README default 101). New in v1.11.",
      "type": "object",
      "properties": {
        "handleId": {
          "description": "K-04 handles.id of the handle the request names (K-08 v1 handleRef).",
          "$ref": "../event-trace/event-trace.v1.schema.json#/$defs/handleRef"
        },
        "businessId": {
          "description": "No business: the rows name none the handle's people act for.",
          "type": "null"
        },
        "personId": {
          "description": "K-04 person_handles.person_id when the handle has exactly one person; null when it has none or several (README default 97).",
          "$ref": "#/$defs/nullableId"
        },
        "zone": {
          "description": "No zone is stored for a party with no business: never one the read makes up, UTC included (refuse-turn-party-no-business-zone-utc; README default 101).",
          "type": "null"
        }
      },
      "required": ["handleId", "businessId", "personId", "zone"],
      "additionalProperties": false
    },
    "readTurnParty.unknown": {
      "title": "ReadTurnPartyUnknown",
      "description": "No K-04 handle has the request's kind and address (README default 96). Every field null: the port answers null ('Null: not known, so no turn runs': runtime/src/turn/types.ts TurnDirectory), and no turn or park runs. The gateway's handleSealingKey writes a handle at its first sight, before its text reaches the actor (K-05 v1.2 item 29), so this is a record that lost the handle, never a first text. New in v1.11.",
      "type": "object",
      "properties": {
        "handleId": {
          "type": "null"
        },
        "businessId": {
          "type": "null"
        },
        "personId": {
          "type": "null"
        },
        "zone": {
          "type": "null"
        }
      },
      "required": ["handleId", "businessId", "personId", "zone"],
      "additionalProperties": false
    },
    "readTurnParty.response": {
      "title": "ReadTurnPartyResponse",
      "description": "The handle's party at one business, its party at no business, or an unknown handle (README item 52). An unknown handle is an answer, not an error, as for v1.10's two handle reads (README default 95); a party the rows cannot give is an error (businessUndecidedError), never an answer, so no consumer can take it for a party. New in v1.11.",
      "oneOf": [
        {
          "$ref": "#/$defs/readTurnParty.atBusiness"
        },
        {
          "$ref": "#/$defs/readTurnParty.noBusiness"
        },
        {
          "$ref": "#/$defs/readTurnParty.unknown"
        }
      ]
    },
    "businessUndecidedError": {
      "title": "BusinessUndecidedError",
      "description": "The rows do not give one business the handle may act for, so no party is answered and the turn never runs under a business picked for it, or under no business in its place (README item 52, default 102; QUESTIONS.md CQ-220's lead note: whatever cannot be decided from the rows fails closed). The reason, the first of the three that applies in this order (README default 100): anotherOwner, a company one of the handle's people owns names a business whose live owner role another person holds (S2-02: 'One account owner'; S11-100: 'Sam's access ends at the handover time'); roleEnded, a company one of them owns names a business at which none of them holds the live owner role and one of them holds a role that ended (S11-100; RULES 8.7); severalBusinesses, their live roles and owned companies name more than one business, or a business beside a company that has none yet (S13-27 rule 29: 'Read the role from what the message is about. When two roles fit, ask which one'). It carries the handle's id and the person, as a party would give them, so a later runtime card can still record a STOP, START or HELP, which covers every business, and park the turn, with no business (open gap 57); never a business, a role, a company, another person or the businesses found. New in v1.11.",
      "type": "object",
      "properties": {
        "error": {
          "const": "businessUndecided"
        },
        "reason": {
          "description": "Why no business is given (README item 52, defaults 99 and 100).",
          "type": "string",
          "enum": ["anotherOwner", "roleEnded", "severalBusinesses"]
        },
        "handleId": {
          "description": "K-04 handles.id of the handle the request names (K-08 v1 handleRef).",
          "$ref": "../event-trace/event-trace.v1.schema.json#/$defs/handleRef"
        },
        "personId": {
          "description": "The handle's one person, or null when it has none or several (README default 97).",
          "$ref": "#/$defs/nullableId"
        }
      },
      "required": ["error", "reason", "handleId", "personId"],
      "additionalProperties": false
    },
    "readTurnParty.errors": {
      "title": "ReadTurnPartyErrors",
      "description": "businessUndecided: the rows give no one business the handle may act for, so no turn runs on a business picked for it (README default 102); transient: the same request may be sent again. An error is never read as a party (README default 61's rule). A read writes nothing. New in v1.11.",
      "oneOf": [
        {
          "$ref": "#/$defs/businessUndecidedError"
        },
        {
          "$ref": "#/$defs/transientError"
        }
      ]
    },
    "readTurnParty.exchange": {
      "title": "ReadTurnPartyExchange",
      "description": "One readTurnParty request with its outcome: the handle's party, an unknown handle, or one of its errors. New in v1.11.",
      "type": "object",
      "properties": {
        "call": {
          "const": "readTurnParty"
        },
        "given": {
          "$ref": "#/$defs/given"
        },
        "request": {
          "$ref": "#/$defs/readTurnParty.request"
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/readTurnParty.response"
            },
            {
              "$ref": "#/$defs/readTurnParty.errors"
            }
          ]
        }
      },
      "required": ["call", "given", "request", "outcome"],
      "additionalProperties": false
    }
  }
}
