    { "$ref": "#/$defs/pageTeam.exchange" },
    { "$ref": "#/$defs/acknowledgePage.exchange" },
    { "$ref": "#/$defs/openReviewItem.exchange" },
    { "$ref": "#/$defs/decideReviewItem.exchange" },
    { "$ref": "#/$defs/enterDoor.exchange" },
    { "$ref": "#/$defs/sendFixedLine.exchange" },
