    { "$ref": "#/$defs/readBackBusinessBooking.exchange" },
    { "$ref": "#/$defs/findCustomer.exchange" },
    { "$ref": "#/$defs/checkBookingFirst.exchange" },
    { "$ref": "#/$defs/setCustomerBlock.exchange" },
    { "$ref": "#/$defs/matchService.exchange" },
    { "$ref": "#/$defs/setWhoFor.exchange" },
    { "$ref": "#/$defs/setReachWay.exchange" },
    { "$ref": "#/$defs/addCustomer.exchange" },
    { "$ref": "#/$defs/setPrice.exchange" },
    { "$ref": "#/$defs/quoteFromPhotos.exchange" },
    { "$ref": "#/$defs/showTimes.exchange" },
    { "$ref": "#/$defs/saveTime.exchange" },
    { "$ref": "#/$defs/extendTime.exchange" },
    { "$ref": "#/$defs/joinWaitlist.exchange" },
    { "$ref": "#/$defs/sendSecureLink.exchange" },
    { "$ref": "#/$defs/checkPlace.exchange" },
    { "$ref": "#/$defs/saveSecurePage.exchange" },
    { "$ref": "#/$defs/showMoneyBefore.exchange" },
    { "$ref": "#/$defs/settleOffer.exchange" },
    { "$ref": "#/$defs/signDocument.exchange" },
    { "$ref": "#/$defs/takeMoneyBefore.exchange" },
    { "$ref": "#/$defs/refundAtOnce.exchange" },
    { "$ref": "#/$defs/askOwnerFirst.exchange" },
    { "$ref": "#/$defs/sendToOnCall.exchange" },
    { "$ref": "#/$defs/writeBooking.exchange" },
    { "$ref": "#/$defs/recordStaffTold.exchange" },
    { "$ref": "#/$defs/askAboutClash.exchange" }
  ],
