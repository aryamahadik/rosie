    "buildFrontier.request": { "$ref": "tool-api.v1.4.schema.json#/$defs/buildFrontier.request" },
    "buildFrontier.response": {
      "title": "BuildFrontierResponse",
      "description": "The context for decide, with what the builder flagged or collapsed, as v1, with one change: the context is K-02 v1.1's, whose doors also take signUp, the door to S1-01 a new number's first text is offered (README v1.5 default 128; K-02 v1.1 default 9). Every v1 to v1.4 response is a v1.5 response.",
      "type": "object",
      "properties": {
        "context": {
          "description": "K-02 v1.1's context bundle, passed to decide unchanged (CQ-25 settled: the AI gateway's two calls a read are the wire form, not the Tool API's). writer.handle is the writer's own number, the turn's own data: C-114 leaves it out of the prompt.",
          "$ref": "../model/model.v1.1.schema.json#/$defs/context"
        },
        "flagged": {
          "description": "Steps flagged for a fix: a second value for one key was refused and the home's value went in (arch 02 line 117; this closes nm01).",
          "type": "array",
          "items": {
            "title": "FlaggedStep",
            "type": "object",
            "properties": {
              "stepId": {
                "$ref": "#/$defs/stepId"
              },
              "key": {
                "description": "The fact key that had a second value (arch 02 line 117).",
                "type": "string",
                "minLength": 1
              },
              "kept": {
                "description": "The home's row and version whose value went in (S13-30).",
                "$ref": "#/$defs/rowRef"
              }
            },
            "required": ["stepId", "key", "kept"],
            "additionalProperties": false
          }
        },
        "collapsedBookingIds": {
          "description": "Bookings other than the target collapsed to one 'which booking?' choice because the frontier passed 60 (arch 03 line 167); empty when none.",
          "type": "array",
          "items": {
            "$ref": "../common/formats.v1.schema.json#/$defs/id"
          }
        }
      },
      "required": ["context", "flagged", "collapsedBookingIds"],
      "additionalProperties": false
    },
    "buildFrontier.errors": { "$ref": "tool-api.v1.4.schema.json#/$defs/buildFrontier.errors" },
    "closestEntries.request": {
      "title": "ClosestEntriesRequest",
      "description": "Add the closest entries when nothing fits, as v1 (arch 03 line 189; K-02 context.meaningSearch; Q-42; README default 3: 200 ms; once per turn), with one change: the context is K-02 v1.1's, so a frontier that offered the sign-up door can go on to meaning search (README 'v1.5'). Every v1 request is a v1.5 request.",
      "type": "object",
      "properties": {
        "caller": {
          "$ref": "#/$defs/caller"
        },
        "context": {
          "description": "The turn's context as buildFrontier gave it (K-02 v1.1).",
          "$ref": "../model/model.v1.1.schema.json#/$defs/context"
        },
        "quotes": {
          "description": "The parts of the text nothing fit, each by its exact quote (arch 03 line 185).",
          "type": "array",
          "items": {
            "description": "A quote of a part nothing fit (K-02 v1 noneFits).",
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": ["caller", "context", "quotes"],
      "additionalProperties": false
    },
    "closestEntries.response": {
      "title": "ClosestEntriesResponse",
      "description": "The context with the closest entries added, as v1, the context K-02 v1.1's (README 'v1.5').",
      "type": "object",
      "properties": {
        "context": {
          "description": "The same context with at most 3 entry steps added as choices of kind searchEntry and meaningSearch set (K-02 v1.1).",
          "$ref": "../model/model.v1.1.schema.json#/$defs/context"
        },
        "added": {
          "description": "The entry steps added, closest first (arch 03 line 189).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/stepId"
          },
          "maxItems": 3
        }
      },
      "required": ["context", "added"],
      "additionalProperties": false
    },
    "closestEntries.errors": { "$ref": "tool-api.v1.4.schema.json#/$defs/closestEntries.errors" },
    "plannerVerbs.request": { "$ref": "tool-api.v1.4.schema.json#/$defs/plannerVerbs.request" },
