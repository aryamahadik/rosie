    "coreResult": { "$ref": "tool-api.v1.4.schema.json#/$defs/coreResult" },
    "partResult": { "$ref": "tool-api.v1.4.schema.json#/$defs/partResult" },
    "gateAndCommit.request": {
      "title": "GateAndCommitRequest",
      "description": "Gate and commit a turn, as v1 (arch 02 line 121; arch 06 lines 295 to 309; arch 10 line 508; K-05 v1 commitTurn and fireClock; README 'Reads, repeats and time budgets': the primary, uncached; the turn id is the key; at most 300 ms), with one change: decided texts carry K-02 v1.1's context with decide's result, so a part may enter the sign-up door, whose walk writes S1-01's thread and S1-02's question, its clock row and one outbox row in the one commit (README v1.5 defaults 128 to 133; commit-s1-01.json). Every v1 to v1.4 request is a v1.5 request.",
      "type": "object",
      "properties": {
        "caller": {
          "$ref": "#/$defs/caller"
        },
        "turn": {
          "description": "The turn row the commit writes (K-05 v1 turn); every input but a clock's needs one. For a clock's firing (input.kind clock), the clock turn on the clock row's handle, or null when the firing's writes hold no outbox row (K-05 v1 fireClock.request.turn), as for any row no handle owns (K-04 turns.handle_id is not null). A clock turn has no texts: its one event id is the clock row's id (K-05 v1 default 9), its id is that event id's hash, as every turn's is (CQ-09), so one row's firing has one turn id and a repeat finds the first firing, and its trace id is the firing's own (CQ-06); its caller.kind is turn, with caller.turnId and caller.requestId its id. A firing with no turn is called with caller.kind clockFiring, caller.turnId null and caller.requestId the clock row's id. The named rule clockTurn checks these.",
          "anyOf": [
            {
              "$ref": "../data-access/data-access.v1.schema.json#/$defs/turn"
            },
            {
              "type": "null"
            }
          ]
        },
        "input": {
          "description": "What the turn acts on: decided texts, a clock's firing, or only core actions (the guard's keyword-only texts: arch 02 line 115).",
          "oneOf": [
            {
              "title": "DecidedInput",
              "type": "object",
              "properties": {
                "kind": {
                  "const": "decided"
                },
                "decided": {
                  "description": "The context and decide's result, as the gate reads them (K-02 v1.1 contextAndDecide: v1's, its doors also taking signUp; its named rules are the gate's: optionOffered, quoteInText).",
                  "$ref": "../model/model.v1.1.schema.json#/$defs/contextAndDecide"
                },
                "planner": {
                  "description": "The planner's verb when nothing fit after meaning search; null otherwise.",
                  "anyOf": [
                    {
                      "$ref": "#/$defs/plannerVerbs.request"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["kind", "decided", "planner"],
              "additionalProperties": false
            },
            {
              "title": "ClockInput",
              "description": "A clock's firing runs its step's clock branch, the safe default and who is told, with no decide reads (QUESTIONS.md NQ-RT-4; arch 02 line 127), and answers fired (gateAndCommit.response), or notArmed, notDue or the clock row's versionChanged (gateAndCommit.errors). A version change on a row the branch read reloads once and runs the branch again, as limit 4 does (arch 06 line 305).",
              "type": "object",
              "properties": {
                "kind": {
                  "const": "clock"
                },
                "clockRowId": {
                  "description": "The clock row firing (K-05 v1 fireClock).",
                  "$ref": "../common/formats.v1.schema.json#/$defs/id"
                },
                "expectVersion": {
                  "$ref": "#/$defs/version"
                },
                "firedAt": {
                  "$ref": "../common/formats.v1.schema.json#/$defs/utc"
                },
                "by": {
                  "description": "As K-05 v1 fireClock.request.by: the actor's alarm, the minute sweep, or staging's Fire now (BP 9.4).",
                  "type": "string",
                  "enum": ["alarm", "sweep", "fireNow"]
                },
                "jobId": {
                  "description": "The firing's job id for the event log (K-05 v1 fireClock).",
                  "$ref": "../common/formats.v1.schema.json#/$defs/id"
                }
              },
              "required": ["kind", "clockRowId", "expectVersion", "firedAt", "by", "jobId"],
              "additionalProperties": false
            },
            {
              "title": "CoreOnlyInput",
              "description": "Only core actions: STOP, START, HELP and the like, which code alone acts on (arch 02 line 115).",
              "type": "object",
              "properties": {
                "kind": {
                  "const": "coreOnly"
                }
              },
              "required": ["kind"],
              "additionalProperties": false
            }
          ]
        },
        "core": {
          "description": "Shared-core calls this turn commits, in order (README 'In a turn or alone'). Each of the turn's texts carries one recordSafetyOutcome, whatever its outcome, since K-34 v1 writes one outcome row per text under the turn that joins it (README default 5); a clock's turn carries none.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/coreAction"
          }
        },
        "now": {
          "description": "The time the gate reads 'now' at.",
          "$ref": "../common/formats.v1.schema.json#/$defs/utc"
        }
      },
      "required": ["caller", "turn", "input", "core", "now"],
      "additionalProperties": false,
      "if": {
        "properties": {
          "input": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "clock"
              }
            },
            "required": ["kind"]
          }
        },
        "required": ["input"]
      },
      "then": {
        "description": "A clock's firing: its turn may be null (K-05 v1 fireClock.request.turn); the named rule clockTurn checks the caller and the turn's id rule."
      },
      "else": {
        "description": "Decided texts or core actions only: the turn is required (K-05 v1 commitTurn).",
        "properties": {
          "turn": {
            "$ref": "../data-access/data-access.v1.schema.json#/$defs/turn"
          }
        }
      }
    },
