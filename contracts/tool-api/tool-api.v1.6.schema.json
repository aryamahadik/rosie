    "composeInput.response": {
      "title": "ComposeInputResponse",
      "description": "The composer input, or the text row an email copy takes its plan from, as v1, with one change (v1.6, T-1173; README 'v1.6'): the input is K-03 v1.1's composeInput (../message-plan/message-plan.v1.1.schema.json), each of whose facts is a slot fact (K-03 v1's fact) or a term fact, one of Rosie's own fixed terms that the row's step card states, word for word, with its source line (K-03 v1.1 termFact; CQ-82, CQ-86; DL-355). Every K-03 v1 input is a K-03 v1.1 input, so every v1 to v1.5 response is a v1.6 response.",
      "oneOf": [
        {
          "title": "ComposeInputReady",
          "type": "object",
          "properties": {
            "result": {
              "const": "compose"
            },
            "input": {
              "description": "K-03 v1.1's composer input for the row (arch 07 line 397), never the frontier: its slot facts only as limit 7 lets this reader see them (arch 06 line 311; C-091), and its term facts, each a line of the step's compiled card that names no slot, copied word for word from the bundle the row was committed under, with its source line (K-03 v1.1 README 'v1.1'; README v1.6 defaults 137 and 138; the named rule termFactsFromCard).",
              "$ref": "../message-plan/message-plan.v1.1.schema.json#/$defs/composeInput"
            }
          },
          "required": ["result", "input"],
          "additionalProperties": false
        },
        {
          "title": "ComposeInputEmailCopy",
          "type": "object",
          "properties": {
            "result": {
              "const": "emailCopy"
            },
            "textRowId": {
              "description": "The text row whose plan the copy reuses (K-03 v1 rowPlan.copyOf; RULES 4.1).",
              "$ref": "../common/formats.v1.schema.json#/$defs/id"
            }
          },
          "required": ["result", "textRowId"],
          "additionalProperties": false
        }
      ]
    },
    "composeInput.errors": {
      "title": "ComposeInputErrors",
      "description": "Refused, nothing composed and nothing written: composeInput's errors, v1.5's four (notFound, alreadyPlanned, rowClosed, transient) and, from v1.6 (T-1173; T-309's open question; README v1.6 defaults 139 and 140), fixedLineRow, a row whose words are a fixed line code writes word for word, and masterLineMissing, a row whose master line its bundle cannot give. Each is a JSON object with its own \"error\" code (02-contracts section 2 item 2). Every v1 to v1.5 error is a v1.6 error.",
      "oneOf": [
        { "$ref": "tool-api.v1.5.schema.json#/$defs/composeInput.errors" },
        { "$ref": "#/$defs/fixedLineRowError" },
        { "$ref": "#/$defs/masterLineMissingError" }
      ]
    },
    "fixedLineRowError": {
      "title": "FixedLineRowError",
      "description": "composeInput only (v1.6, T-1173; README v1.6 default 139; v1 open gap 16; T-309's open question): the row carries a fixed line, whose words code writes into it word for word (arch 07 line 361: fixed lines go word for word), such as the guard's STOP, START and HELP replies, a safety line or an outage line, each an outbox row while PostgreSQL is up (README default 6; NQ-RT-9). Such a row is never composed: no composer input is built, no model is called for it and nothing was written. How its plan is written stays open (README v1.6 open gap 128).",
      "type": "object",
      "properties": {
        "error": {
          "const": "fixedLineRow"
        },
        "outboxRowId": {
          "description": "The row asked about (K-04 v1 outbox_rows).",
          "$ref": "../common/formats.v1.schema.json#/$defs/id"
        },
        "fixedLineId": {
          "description": "The fixed line the row carries, by its id in the row's bundle, such as stopReply (K-01 v1 fixedLine.id).",
          "$ref": "#/$defs/fixedLineId"
        }
      },
      "required": ["error", "outboxRowId", "fixedLineId"],
      "additionalProperties": false
    },
    "masterLineMissingError": {
      "title": "MasterLineMissingError",
      "description": "composeInput only (v1.6, T-1173; README v1.6 default 140; T-309's open question): the row's master line cannot be read, so there is no <master_text> to compose from (arch 07 line 401) and nothing is composed (fail closed): the row's bundle is in neither KV nor PostgreSQL's copy (arch 10 line 536), the bundle holds no such step (K-01 v1: a step a bundle does not hold is not reachable), or the step prints no line from Rosie to this reader at the row's place. Nothing was written. Not transient: the same request answers the same until the row's bundle or step changes.",
      "type": "object",
      "properties": {
        "error": {
          "const": "masterLineMissing"
        },
        "outboxRowId": {
          "description": "The row asked about (K-04 v1 outbox_rows).",
          "$ref": "../common/formats.v1.schema.json#/$defs/id"
        },
        "bundleId": {
          "description": "The bundle the row's turn pinned, where its step's line was looked for (arch 10 line 548: the bundle id is on every turn).",
          "$ref": "../common/formats.v1.schema.json#/$defs/bundleId"
        },
        "step": {
          "description": "The step whose line the row carries (K-01 v1 stepId).",
          "$ref": "#/$defs/stepId"
        },
        "missing": {
          "description": "What is missing: bundle (in neither KV nor PostgreSQL's copy: arch 10 line 536), step (in none of the bundle's flow graphs) or line (the step prints no line from Rosie to this reader at the row's place).",
          "type": "string",
          "enum": ["bundle", "step", "line"]
        }
      },
      "required": ["error", "outboxRowId", "bundleId", "step", "missing"],
      "additionalProperties": false
    },
